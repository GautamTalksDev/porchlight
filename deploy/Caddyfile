# HTTPS in front of the city app. Certificates come from Let's Encrypt automatically.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# Server-sent events (the live operations room) are flushed immediately by Caddy.
	reverse_proxy city:3000
	log {
		output stdout
		format json
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
