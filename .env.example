# Porchlight environment
# Copy this file to .env and fill in what you need. Never commit .env (it is in .gitignore).
# Everything is optional for a local demo: missing integrations fall back gracefully and say so on screen.

# Neighbourhood node (apps/node)

# Name shown in the node console. Lowercase letters, digits and hyphens.
NODE_NAME=node-a
# Household this node sits in (Porch Circles). Must match an id in HOUSEHOLDS_FILE.
NODE_HOUSEHOLD=hh-oak-19
# 0.0.0.0 lets neighbour laptops on the same hotspot reach this node.
HOST=0.0.0.0
PORT=7401
# Where this node keeps its log and identity. Use a different folder per node on one machine.
DATA_DIR=./data/node-a
# Other nodes on the hotspot, comma separated, for example http://192.168.43.12:7401
PEERS=
# The city app address, for example https://porchlight.example or http://localhost:3000
# Leave empty to run neighbour only.
CITY_URL=
# Shared secret the city checks on every delivery. Must match the city. Generate with: openssl rand -hex 32
CITY_INGEST_TOKEN=dev-only-token-change-me
# Optional. Pin the city's origin id (16 hex) so this node accepts city notices before the first uplink.
# Normally learned automatically from ingest and saved as city-id.json next to identity.json.
CITY_ID=
# Optional network key. When set, every gossip request between nodes is signed with it. Same value on every node.
NETWORK_KEY=
# Optional allow list of node ids (comma separated). Empty means accept any valid signature.
ROSTER=
# Beacon id and its 16 byte key as 32 hex characters. Generate a pair with: npm run keygen pl-b01
# The value below is the public demo key. Replace it before judging.
BEACON_KEYS=pl-b01:000102030405060708090a0b0c0d0e0f
HOUSEHOLDS_FILE=./config/households.json
GOSSIP_INTERVAL_MS=2000
GOSSIP_FANOUT=2
UPLINK_INTERVAL_MS=3000
# Porch Circles: seconds before a call escalates from buddies to the street, then to the city. Use 30 for demos.
BUDDY_WINDOW_SEC=300
STREET_WINDOW_SEC=300
# Simulated packet loss for demos, from 0 to 0.95. Can also be changed live in the console.
CHAOS_DROP=0
# true exposes the node console to the whole network. Keep false unless you know why.
UI_PUBLIC=false
# true shows "simulate a press" buttons so the team can test without the Arduino. Set false for judging.
DEV_SIMULATE_BEACON=true
DEFAULT_LANG=en

# City app (apps/city)

# Public address of the city app, used by Auth0 for callbacks.
APP_BASE_URL=http://localhost:3000
# Auth0 Regular Web Application. Callback: <APP_BASE_URL>/auth/callback, logout: <APP_BASE_URL>
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Encrypts session cookies. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# Optional allow list of coordinator emails (comma separated). Empty means any Auth0 user may sign in.
COORDINATOR_EMAILS=

# Tiger Data (PostgreSQL with TimescaleDB). Copy the connection string from the Tiger Cloud console.
# Empty means the city keeps everything in memory, which is fine for a demo.
DATABASE_URL=

# Google Gemini, for ranking who needs help first and drafting French notices.
# Key from https://aistudio.google.com
GEMINI_API_KEY=
# Ordered list tried on each call (comma-separated). Used by triage and notice translation.
# If unset, GEMINI_MODEL then GEMINI_FALLBACK_MODEL are used. If those are unset too, this default list is used.
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-2.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash-lite
# Legacy single-model settings (used only when GEMINI_MODELS is empty).
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Minutes without any sign of life before a vulnerable home is flagged. Use 1 for demos.
SILENCE_MINUTES=30

# Porch Circles: the city also reads BUDDY_WINDOW_SEC and STREET_WINDOW_SEC (set with the node
# settings above) so the operations room shows the same escalation tier as the street.

# ElevenLabs, for voice check-ins and the offline voice clips.
ELEVENLABS_API_KEY=
# Voice ids from the ElevenLabs voice library. Empty uses a default voice.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_FR=
# Agent id from ElevenLabs Agents. Setup steps in docs/DEPLOY.md.
ELEVENLABS_AGENT_ID=
# Separate agent for the coordinator voice copilot (Hey Porchlight). Setup in docs/DEPLOY.md.
ELEVENLABS_COPILOT_AGENT_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# The city signs its own actions. Leave empty to generate a key in CITY_DATA_DIR on first start.
CITY_IDENTITY=
CITY_DATA_DIR=./.data
# Optional path to a real household registry. Empty uses the fictional demo registry in config/.
CITY_REGISTRY_FILE=

# Demo only. When true, coordinators can wipe city demo state with Shift+R in the operations room.
# Keep false in production.
DEMO_RESET_ENABLED=false

# Deployment (docker compose on Vultr)

# Your domain, for example porchlight.example. Caddy gets a TLS certificate for it automatically.
DOMAIN=
# Email for Let's Encrypt notices.
ACME_EMAIL=

# Public link to the source code, shown on the landing page.
REPO_URL=
